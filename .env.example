# Copy to .env.local and fill in. Everything below is optional for the
# landing page — each integration stays inert until its keys are present.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Clerk (auth) -----------------------------------------------------------
# Auth is not built yet. Setting these only mounts <ClerkProvider>.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Supabase (Postgres host + storage) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Drizzle / Postgres -----------------------------------------------------
# Supabase connection string (use the pooled URL for serverless runtimes).
DATABASE_URL=""

# --- Polar (payments + subscriptions) ---------------------------------------
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# "sandbox" | "production"
POLAR_SERVER="sandbox"
NEXT_PUBLIC_POLAR_ORGANIZATION_ID=""

# --- PostHog (product analytics) --------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Sentry (error tracking) ------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Only needed in CI to upload source maps.
SENTRY_AUTH_TOKEN=""
